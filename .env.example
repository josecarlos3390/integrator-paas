# =============================================================================
# Variables de entorno para docker-compose.yml
# =============================================================================

# SAP B1 Service Layer
SAP_PASSWORD=YourSapPassword

# SAP HANA (schema INTEGRATION_BUS)
HANA_CONNECTION_STRING=Driver={HDBODBC};SERVERNODE=sapserver:39017;Database=INTEGRATION_BUS;UID=INTEGRATION_USER;PWD=YourHanaPassword;CS=INTEGRATION_BUS;

# PostgreSQL propia del integration bus
POSTGRES_PASSWORD=integration
POSTGRES_CONNECTION_STRING=Host=postgres;Database=integration_bus;Username=integration;Password=integration

# CRM externo
CRM_API_KEY=YourCrmApiKey

# Dashboard maestro (/api/master): SHA-256 hex de la clave X-Admin-Key.
# Generar con: echo -n "tu-clave" | sha256sum
ADMIN_MASTER_API_KEY_HASH=
